{
  "manifest_version": 3,
  "name": "BiliBridge",
  "version": "0.1.2",
  "description": "用 PotPlayer 播放当前 B 站视频或直播，并连接托盘程序。",
  "key": "",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["https://api.bilibili.com/*", "https://www.bilibili.com/*"],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_title": "BiliBridge",
    "default_icon": {"16": "icons/16.png", "24": "icons/24.png", "32": "icons/32.png"}
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/bangumi/play/*", "https://live.bilibili.com/*"],
      "js": ["player-source.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://live.bilibili.com/*"],
      "js": ["video.js"],
      "css": ["video.css"],
      "run_at": "document_idle"
    }
  ]
}
